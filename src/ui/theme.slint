export component VecIcon inherits VerticalLayout {
    in property <string> path-data;
    in property <color> icon-color: Theme.text-primary;
    in property <length> icon-size: 18px;
    width: root.icon-size;
    alignment: center;

    Path {
        width: root.icon-size;
        height: root.icon-size;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.icon-color;
        commands: root.path-data;
    }
}

export component FluentCard inherits Rectangle {
    background: Theme.bg-card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
}

export component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <int> tone: 0; // 0=neutral, 1=success, 2=warning, 3=danger, 4=info
    border-radius: 6px;
    border-width: 1px;
    height: 24px;
    background: tone == 1 ? Theme.success-bg
              : tone == 2 ? Theme.warning-bg
              : tone == 3 ? Theme.danger-bg
              : tone == 4 ? Theme.info-bg
              : Theme.bg-subtle;
    border-color: tone == 1 ? Theme.success-bd
                : tone == 2 ? Theme.warning-bd
                : tone == 3 ? Theme.danger-bd
                : tone == 4 ? Theme.info-bd
                : Theme.border;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            color: tone == 1 ? Theme.success-fg
                 : tone == 2 ? Theme.warning-fg
                 : tone == 3 ? Theme.danger-fg
                 : tone == 4 ? Theme.info-fg
                 : Theme.text-secondary;
        }
    }
}

export component PillFilter inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    background: root.active ? Theme.accent-soft
              : area.has-hover ? Theme.bg-card-hover : Theme.bg-card;
    border-color: root.active ? Theme.accent-border : Theme.border;

    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 12.5px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            color: root.active ? Theme.accent : Theme.text-secondary;
        }
    }
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;

    Text {
        text: root.title;
        font-size: 22px;
        font-weight: 700;
        color: Theme.text-primary;
    }
    Text {
        text: root.subtitle;
        font-size: 13.5px;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}
