import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Icons, VecIcon, FluentCard, StatusBadge, PillFilter, PageHeader, InspectItemUi } from "theme.slint";

export component InspectView inherits Rectangle {
    in-out property <string> query-path;
    in-out property <bool> include-hard-links: true;
    in-out property <int> max-depth: 4;

    in property <bool> is-scanning: false;
    in property <string> status-text: "输入或选择路径后，可剖析单个链接属性或递归扫描文件夹内全部符号链接。";

    // Single path inspection result
    in property <bool> has-single-result: false;
    in property <string> single-path;
    in property <string> single-kind-code;
    in property <string> single-kind-label;
    in property <string> single-target;
    in property <string> single-detail;
    in property <bool> single-healthy: false;
    in property <bool> single-can-unlink: false;
    in property <[string]> single-siblings;

    // Recursive scan results
    in property <[InspectItemUi]> scan-rows;

    callback browse-folder();
    callback browse-file();
    callback inspect-single();
    callback start-scan();
    callback cancel-scan();
    callback reveal-path(string);
    callback copy-text(string);
    callback inspect-specific(string);
    callback request-unlink(string);

    background: transparent;

    scroll := ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: scroll.visible-width;
            padding-top: 2px;
            padding-bottom: 20px;
            padding-right: 14px;
            spacing: 16px;

            PageHeader {
                title: "体检与扫描";
                subtitle: "深入检查单个文件/目录的 NTFS 重解析点、目标健康度，或异步扫描目录下的全部链接。";
            }

            // Toolbar Card
            FluentCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            min-width: 0;
                            height: 36px;
                            font-size: 13.5px;
                            placeholder-text: "输入或粘贴需要检查的文件 / 文件夹路径...";
                            text <=> root.query-path;
                        }
                        Button {
                            text: "选文件夹";
                            height: 36px;
                            clicked => { root.browse-folder(); }
                        }
                        Button {
                            text: "选文件";
                            height: 36px;
                            clicked => { root.browse-file(); }
                        }
                        Button {
                            text: "单路径体检";
                            height: 36px;
                            clicked => { root.inspect-single(); }
                        }
                        if !root.is-scanning : Button {
                            text: "扫描目录链接";
                            primary: true;
                            height: 36px;
                            clicked => { root.start-scan(); }
                        }
                        if root.is-scanning : Button {
                            text: "取消扫描";
                            height: 36px;
                            clicked => { root.cancel-scan(); }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        CheckBox {
                            text: "扫描时统计同分区文件硬链接 (/H)";
                            checked <=> root.include-hard-links;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "递归深度：";
                                font-size: 12.5px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            for depth-opt in [2, 4, 8]: PillFilter {
                                label: depth-opt + " 层";
                                active: root.max-depth == depth-opt;
                                clicked => { root.max-depth = depth-opt; }
                            }
                        }
                    }

                    Text {
                        text: root.status-text;
                        font-size: 13px;
                        color: root.is-scanning ? Theme.accent : Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            // Single Inspection Result Card
            if root.has-single-result : FluentCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "单路径剖析结果";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                            StatusBadge {
                                label: root.single-kind-label;
                                tone: root.single-can-unlink
                                    ? (root.single-healthy ? 1 : 3)
                                    : (root.single-kind-code == "MISSING" ? 3 : 0);
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "在资源管理器定位";
                                clicked => { root.reveal-path(root.single-path); }
                            }
                            if root.single-target != "" : Button {
                                text: "定位目标";
                                clicked => { root.reveal-path(root.single-target); }
                            }
                            if root.single-target != "" : Button {
                                text: "复制目标";
                                clicked => { root.copy-text(root.single-target); }
                            }
                            if root.single-can-unlink : Button {
                                text: "安全解除链接";
                                clicked => { root.request-unlink(root.single-path); }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;

                            Text {
                                text: "检查路径： " + root.single-path;
                                font-family: "Cascadia Mono";
                                font-size: 12.5px;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }
                            if root.single-target != "" : Text {
                                text: "实际指向： " + root.single-target;
                                font-family: "Cascadia Mono";
                                font-size: 12.5px;
                                color: root.single-healthy ? Theme.success-fg : Theme.danger-fg;
                                wrap: word-wrap;
                            }
                            if root.single-detail != "" : Text {
                                text: root.single-detail;
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.single-siblings.length > 0 : VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "同分区硬链接兄弟路径（共 " + root.single-siblings.length + " 处共享同一文件扇区）：";
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        for sib in root.single-siblings : Text {
                            text: "  • " + sib;
                            font-family: "Cascadia Mono";
                            font-size: 12px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Scanned Directory Results List
            if root.scan-rows.length > 0 : FluentCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    Text {
                        text: "扫描发现的链接条目（" + root.scan-rows.length + " 项）";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    for item in root.scan-rows : Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: row-area.has-hover ? Theme.bg-card-hover : Theme.bg-subtle;
                        animate background { duration: 120ms; }

                        row-area := TouchArea {}

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: 0;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    StatusBadge {
                                        label: item.kind-code;
                                        tone: item.is-reparse ? 4 : 0;
                                    }
                                    StatusBadge {
                                        label: item.target-healthy ? "有效" : "目标异常";
                                        tone: item.target-healthy ? 1 : 3;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        min-width: 0;
                                        text: item.path;
                                        font-family: "Cascadia Mono";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: item.target-path != ""
                                        ? "指向 → " + item.target-path
                                        : item.detail-note;
                                    font-family: "Cascadia Mono";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;

                                Button {
                                    text: "剖析";
                                    clicked => { root.inspect-specific(item.path); }
                                }
                                Button {
                                    text: "定位";
                                    clicked => { root.reveal-path(item.path); }
                                }
                                if item.is-reparse || item.hard-link-count > 1 : Button {
                                    text: "解链";
                                    clicked => { root.request-unlink(item.path); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
