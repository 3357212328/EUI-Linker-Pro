import { Palette } from "std-widgets.slint";

export struct InspectItemUi {
    path: string,
    kind-code: string,
    kind-label: string,
    target-path: string,
    detail-note: string,
    target-healthy: bool,
    is-reparse: bool,
    is-relative: bool,
    hard-link-count: int,
}

export struct HistoryItemUi {
    source-index: int,
    timestamp: string,
    type-code: string,
    link-path: string,
    target-path: string,
    result: string,
    success: bool,
}

export global Theme {
    in-out property <bool> is-dark: true;
    out property <bool> dark: root.is-dark;

    // Surface Hierarchy
    out property <color> bg-canvas: dark ? #111318 : #f4f6fa;
    out property <color> bg-sidebar: dark ? #171a21 : #ebeff5;
    out property <color> bg-card: dark ? #1c2029 : #ffffff;
    out property <color> bg-card-hover: dark ? #222733 : #f8fafe;
    out property <color> bg-subtle: dark ? #151820 : #f0f3f8;
    out property <color> bg-code: dark ? #0d1016 : #f1f4f9;
    out property <color> bg-backdrop: #0000008c;

    // Hairline Borders
    out property <color> border: dark ? #2b3140 : #dce2ec;
    out property <color> border-strong: dark ? #3b4459 : #c2ccd9;

    // Typography
    out property <color> text-primary: dark ? #f0f3f8 : #151922;
    out property <color> text-secondary: dark ? #a6b0c3 : #525e72;
    out property <color> text-muted: dark ? #737e93 : #7c879b;

    // Brand Accent (Windows Fluent Blue)
    out property <color> accent: dark ? #4ea1ff : #0067c0;
    out property <color> accent-hover: dark ? #6bb2ff : #0056a3;
    out property <color> accent-soft: dark ? #4ea1ff22 : #0067c018;
    out property <color> accent-border: dark ? #4ea1ff55 : #0067c04d;
    out property <color> accent-on: #ffffff;

    // Semantic Status Colors
    out property <color> success-fg: dark ? #4ade80 : #15803d;
    out property <color> success-bg: dark ? #22c55e20 : #16a34a16;
    out property <color> success-bd: dark ? #22c55e4d : #16a34a40;

    out property <color> warning-fg: dark ? #fbbf24 : #b45309;
    out property <color> warning-bg: dark ? #f59e0b20 : #d9770616;
    out property <color> warning-bd: dark ? #f59e0b4d : #d9770640;

    out property <color> danger-fg: dark ? #f87171 : #b91c1c;
    out property <color> danger-bg: dark ? #ef444420 : #dc262616;
    out property <color> danger-bd: dark ? #ef44444d : #dc262640;

    out property <color> info-fg: dark ? #60a5fa : #0369a1;
    out property <color> info-bg: dark ? #3b82f620 : #0284c714;
    out property <color> info-bd: dark ? #3b82f64d : #0284c73d;
}

