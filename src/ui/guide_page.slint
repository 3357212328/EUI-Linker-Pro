import { Button, ScrollView } from "std-widgets.slint";
import { Theme, Icons, VecIcon, FluentCard, StatusBadge, PageHeader } from "theme.slint";

component GuideSpecCard inherits FluentCard {
    in property <string> badge;
    in property <string> title;
    in property <string> priv;
    in property <bool> priv-free: false;
    in property <string> scope;
    in property <string> delete-behavior;
    in property <string> scenario;

    preferred-width: 0px;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            alignment: space-between;
            spacing: 8px;

            Text {
                text: root.title;
                font-size: 14.5px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            StatusBadge {
                label: root.badge;
                tone: root.priv-free ? 1 : 4;
            }
        }

        Text {
            text: "权限要求： " + root.priv;
            font-size: 13px;
            color: root.priv-free ? Theme.success-fg : Theme.text-secondary;
            wrap: word-wrap;
        }
        Text {
            text: "跨盘/网络： " + root.scope;
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        Text {
            text: "删除安全性： " + root.delete-behavior;
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        Text {
            text: "推荐场景： " + root.scenario;
            font-size: 12.5px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

export component GuideView inherits Rectangle {
    in property <bool> is-admin: false;
    in property <bool> is-dev-mode: false;

    callback relaunch-admin();
    callback open-dev-settings();
    callback refresh-privileges();

    background: transparent;

    guide-scroll := ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: guide-scroll.visible-width;
            padding-top: 2px;
            padding-bottom: 20px;
            padding-right: 14px;
            spacing: 16px;

            PageHeader {
                title: "环境与指南";
                subtitle: "实时检测当前系统提权能力，并对照不同 NTFS 链接方式的特性与安全边界。";
            }

            // Environment & Privilege Card
            FluentCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        Text {
                            text: "系统权限与免提权能力检测";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "刷新状态";
                                clicked => { root.refresh-privileges(); }
                            }
                            Button {
                                text: "打开开发者设置";
                                clicked => { root.open-dev-settings(); }
                            }
                            if !root.is-admin : Button {
                                text: "以管理员身份重启";
                                primary: true;
                                clicked => { root.relaunch-admin(); }
                            }
                        }
                    }

                    priv-row := HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            width: (priv-row.width - 12px) / 2;
                            border-radius: 8px;
                            background: Theme.bg-subtle;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "UAC 管理员令牌";
                                        font-size: 13.5px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    StatusBadge {
                                        label: root.is-admin ? "已提权 (Admin)" : "标准用户";
                                        tone: root.is-admin ? 1 : 2;
                                    }
                                }
                                Text {
                                    text: root.is-admin
                                        ? "当前可执行包括 /D、文件符号链接及受保护系统目录在内的全部操作。"
                                        : "标准权限即可创建 /J 目录联接和 /H 文件硬链接；需操作系统受保护位置时可一键提权。";
                                    font-size: 12.5px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            width: (priv-row.width - 12px) / 2;
                            border-radius: 8px;
                            background: Theme.bg-subtle;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Windows 开发者模式";
                                        font-size: 13.5px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    StatusBadge {
                                        label: root.is-dev-mode ? "已开启" : "未开启";
                                        tone: root.is-dev-mode ? 1 : 0;
                                    }
                                }
                                Text {
                                    text: root.is-dev-mode
                                        ? "已具备 Windows 免提权创建符号链接能力（/D 与文件符号链接无需 UAC 弹窗）。"
                                        : "开启 Windows「开发人员模式」后，日常用户也可免提权创建目录及文件符号链接。";
                                    font-size: 12.5px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // Matrix Row 1
            m-row1 := HorizontalLayout {
                spacing: 14px;
                GuideSpecCard {
                    width: (m-row1.width - 14px) / 2;
                    title: "目录联接 (/J)";
                    badge: "日常首选";
                    priv-free: true;
                    priv: "无需管理员、无需开启开发者模式";
                    scope: "支持跨本地 NTFS 分区，必须为本地绝对路径";
                    delete-behavior: "解除或删除链接入口本身不会删掉目标文件夹里的真实数据";
                    scenario: "微信/QQ/游戏/SDK 缓存文件夹安全搬家到 D/E 盘。";
                }
                GuideSpecCard {
                    width: (m-row1.width - 14px) / 2;
                    title: "目录符号链接 (/D)";
                    badge: "高兼容性";
                    priv-free: false;
                    priv: "需要管理员权限，或系统已开启开发者模式";
                    scope: "支持跨分区、相对路径与局域网 UNC (\\\\Server\\Share)";
                    delete-behavior: "仅移除链接指针，真实目标目录保持完整无损";
                    scenario: "多机共享项目、需要相对路径随版本库提交的开发工程。";
                }
            }

            // Matrix Row 2
            m-row2 := HorizontalLayout {
                spacing: 14px;
                GuideSpecCard {
                    width: (m-row2.width - 14px) / 2;
                    title: "文件硬链接 (/H)";
                    badge: "零额外占用";
                    priv-free: true;
                    priv: "无需管理员权限";
                    scope: "仅限同一个 NTFS 磁盘分区内的文件";
                    delete-behavior: "所有入口平等指向同一磁盘数据，删除其中一个不影响其余入口";
                    scenario: "同一套游戏 Mod/素材资源多处共用、节省本地 SSD 空间。";
                }
                GuideSpecCard {
                    width: (m-row2.width - 14px) / 2;
                    title: "文件符号链接";
                    badge: "跨盘单文件";
                    priv-free: false;
                    priv: "需要管理员权限，或系统已开启开发者模式";
                    scope: "支持跨本地分区、相对路径与网络共享文件";
                    delete-behavior: "删除链接文件不影响原始源文件；若源文件被删除则链接失效";
                    scenario: "单个配置 (.ini/.json/.yaml) 统一集中管理并映射到多目录。";
                }
            }

            // Safety Checklist Card
            FluentCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;

                    Text {
                        text: "安全使用原则";
                        font-size: 14.5px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "• 搬家并建链时，本工具会使用 robocopy 校验复制完成后再移除原目录并生成重解析点，最大程度降低中途中断风险。";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "• 如需撤销链接，请优先使用「体检与扫描 -> 安全解除链接」，切勿盲目在部分旧版脚本中使用递归删除命令误删目标实体的内容。";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
