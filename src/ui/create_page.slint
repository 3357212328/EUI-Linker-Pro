import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Icons, VecIcon, FluentCard, StatusBadge, PageHeader } from "theme.slint";

component LinkTypeOption inherits Rectangle {
    in property <string> badge;
    in property <string> title;
    in property <string> caption;
    in property <bool> selected: false;
    in property <bool> badge-safe: false;
    callback clicked;

    min-height: 66px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    border-radius: 9px;
    border-width: root.selected ? 1.5px : 1px;
    background: root.selected ? Theme.accent-soft
              : area.has-hover ? Theme.bg-card-hover : Theme.bg-subtle;
    border-color: root.selected ? Theme.accent : Theme.border;

    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 11px;
        spacing: 5px;
        alignment: center;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
                color: root.selected ? Theme.accent : Theme.text-primary;
            }

            Rectangle {
                height: 20px;
                border-radius: 4px;
                background: root.badge-safe ? Theme.success-bg : Theme.bg-card;
                border-width: 1px;
                border-color: root.badge-safe ? Theme.success-bd : Theme.border;
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text {
                        text: root.badge;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: root.badge-safe ? Theme.success-fg : Theme.text-secondary;
                    }
                }
            }
        }

        Text {
            text: root.caption;
            font-size: 12.5px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}

export component CreateView inherits Rectangle {
    // Bound properties from AppWindow
    in-out property <int> operation-mode: 0; // 0=CreateOnly, 1=MoveAndLink
    in-out property <int> link-type: 1;      // 0=/D, 1=/J, 2=/H, 3=FILE
    in-out property <string> link-path;
    in-out property <string> target-path;
    in-out property <bool> auto-create-parent: true;

    in property <bool> is-busy: false;
    in property <int> validation-level: 0;   // 0=Info, 1=Valid, 2=Warning, 3=Error
    in property <string> validation-message: "填写链接位置与目标路径后，会自动完成合规检查。";
    in property <string> quick-fix-label;
    in property <bool> can-execute: false;
    in property <string> command-preview: "cmd /c mklink /J \"<链接路径>\" \"<目标路径>\"";
    in property <string> console-output;
    in property <string> last-created-link;

    callback mode-changed(int);
    callback link-type-changed(int);
    callback parameters-edited();
    callback swap-paths();
    callback browse-link-save();
    callback browse-link-folder();
    callback browse-link-file();
    callback browse-target-folder();
    callback browse-target-file();
    callback apply-quick-fix();
    callback execute-action();
    callback copy-command();
    callback fill-example();
    callback clear-inputs();
    callback reveal-created-link();
    callback inspect-created-link();

    background: transparent;

    scroll := ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: scroll.visible-width;
            padding-top: 2px;
            padding-bottom: 18px;
            padding-right: 14px;
            spacing: 14px;

            // Header + Operation Mode Switcher
            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;

                PageHeader {
                    horizontal-stretch: 1;
                    title: "新建与迁移";
                    subtitle: root.operation-mode == 0
                        ? "在指定入口创建 NTFS 链接，指向现有真实文件或文件夹。"
                        : "使用 robocopy 安全迁移数据至目标盘，并在原路径保留无缝入口。";
                }

                // Segmented Mode Pill
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;

                        for seg in [
                            { id: 0, text: "新建链接" },
                            { id: 1, text: "先搬家再建链" },
                        ]: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: root.operation-mode == seg.id ? Theme.accent : transparent;
                            animate background { duration: 140ms; }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.operation-mode = seg.id;
                                    root.mode-changed(seg.id);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: seg.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    color: root.operation-mode == seg.id ? Theme.accent-on : Theme.text-secondary;
                                }
                            }
                        }
                    }
                }
            }

            // Card 1: Link Type Selector
            FluentCard {
                VerticalLayout {
                    padding: 15px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "1. 选择链接类型";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.operation-mode == 1
                                ? "迁移模式仅支持文件夹链接 (/J 或 /D)"
                                : "普通文件夹重定向推荐选用 目录联接 (/J)";
                            font-size: 12.5px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    row1 := HorizontalLayout {
                        spacing: 12px;

                        LinkTypeOption {
                            width: (row1.width - 12px) / 2;
                            title: "目录联接 (/J)";
                            badge: "免提权 · 推荐";
                            badge-safe: true;
                            caption: "本机文件夹跨盘重定向与软件/游戏目录搬家首选。";
                            selected: root.link-type == 1;
                            clicked => {
                                root.link-type = 1;
                                root.link-type-changed(1);
                            }
                        }

                        LinkTypeOption {
                            width: (row1.width - 12px) / 2;
                            title: "目录符号链接 (/D)";
                            badge: "支持相对/UNC";
                            caption: "功能与 Linux symlink 相同，支持网络共享路径。";
                            selected: root.link-type == 0;
                            clicked => {
                                root.link-type = 0;
                                root.link-type-changed(0);
                            }
                        }
                    }

                    row2 := HorizontalLayout {
                        spacing: 12px;

                        LinkTypeOption {
                            width: (row2.width - 12px) / 2;
                            title: "文件硬链接 (/H)";
                            badge: "免提权 · 同分区";
                            badge-safe: true;
                            caption: "多个文件名共享同一份硬盘扇区数据，删一不丢。";
                            selected: root.link-type == 2;
                            clicked => {
                                root.link-type = 2;
                                root.link-type-changed(2);
                            }
                        }

                        LinkTypeOption {
                            width: (row2.width - 12px) / 2;
                            title: "文件符号链接";
                            badge: "跨分区单文件";
                            caption: "针对单个配置文件跨盘引用的软链接方式。";
                            selected: root.link-type == 3;
                            clicked => {
                                root.link-type = 3;
                                root.link-type-changed(3);
                            }
                        }
                    }
                }
            }

            // Card 2: Paths Configuration
            FluentCard {
                VerticalLayout {
                    padding: 15px;
                    spacing: 11px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "2. 路径配置";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "填入示例";
                                clicked => { root.fill-example(); }
                            }
                            Button {
                                text: "对调路径";
                                clicked => { root.swap-paths(); }
                            }
                            Button {
                                text: "清空";
                                clicked => { root.clear-inputs(); }
                            }
                        }
                    }

                    // Link Path Row
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: root.operation-mode == 1
                                ? "原文件夹位置（当前已有数据，迁移后此处变为链接入口）"
                                : "链接入口位置（要新创建的快捷路径，目前应尚不存在）";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                min-width: 0;
                                height: 36px;
                                font-size: 13.5px;
                                placeholder-text: root.operation-mode == 1
                                    ? "例如：C:\\Users\\Demo\\AppData\\Local\\LargeApp"
                                    : "例如：C:\\Workspace\\LinkEntry";
                                text <=> root.link-path;
                                edited => { root.parameters-edited(); }
                            }
                            Button {
                                text: root.operation-mode == 1 ? "浏览原目录" : "指定新路径...";
                                height: 36px;
                                clicked => {
                                    if (root.operation-mode == 1) {
                                        root.browse-link-folder();
                                    } else {
                                        root.browse-link-save();
                                    }
                                }
                            }
                            if root.operation-mode == 0 && (root.link-type == 2 || root.link-type == 3) : Button {
                                text: "选目录";
                                height: 36px;
                                clicked => { root.browse-link-folder(); }
                            }
                        }
                    }

                    // Target Path Row
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: root.operation-mode == 1
                                ? "迁移目的地（目标盘新文件夹路径，将存放实际文件数据）"
                                : "真实目标路径（已存在的文件或文件夹实体）";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                min-width: 0;
                                height: 36px;
                                font-size: 13.5px;
                                placeholder-text: "例如：D:\\Storage\\RealData";
                                text <=> root.target-path;
                                edited => { root.parameters-edited(); }
                            }
                            if root.link-type == 0 || root.link-type == 1 : Button {
                                text: "选文件夹...";
                                height: 36px;
                                clicked => { root.browse-target-folder(); }
                            }
                            if root.link-type == 2 || root.link-type == 3 : Button {
                                text: "选文件...";
                                height: 36px;
                                clicked => { root.browse-target-file(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        CheckBox {
                            text: "父目录不存在时自动创建上级文件夹";
                            checked <=> root.auto-create-parent;
                            toggled => { root.parameters-edited(); }
                        }
                    }
                }
            }

            // Card 3: Live Validation + Command Preview + Primary Execute
            FluentCard {
                VerticalLayout {
                    padding: 15px;
                    spacing: 11px;

                    // Semantic Pre-flight Banner
                    Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        background: root.validation-level == 1 ? Theme.success-bg
                                  : root.validation-level == 2 ? Theme.warning-bg
                                  : root.validation-level == 3 ? Theme.danger-bg
                                  : Theme.info-bg;
                        border-color: root.validation-level == 1 ? Theme.success-bd
                                    : root.validation-level == 2 ? Theme.warning-bd
                                    : root.validation-level == 3 ? Theme.danger-bd
                                    : Theme.info-bd;

                        HorizontalLayout {
                            padding: 13px;
                            spacing: 12px;
                            alignment: space-between;

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 10px;
                                alignment: start;

                                VecIcon {
                                    icon-size: 18px;
                                    path-data: root.validation-level == 1 ? Icons.check
                                             : (root.validation-level == 2 || root.validation-level == 3) ? Icons.warn
                                             : Icons.add-link;
                                    icon-color: root.validation-level == 1 ? Theme.success-fg
                                              : root.validation-level == 2 ? Theme.warning-fg
                                              : root.validation-level == 3 ? Theme.danger-fg
                                              : Theme.info-fg;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.validation-message;
                                    font-size: 13.5px;
                                    wrap: word-wrap;
                                    color: root.validation-level == 1 ? Theme.success-fg
                                         : root.validation-level == 2 ? Theme.warning-fg
                                         : root.validation-level == 3 ? Theme.danger-fg
                                         : Theme.info-fg;
                                }
                            }

                            if root.quick-fix-label != "" : Button {
                                text: root.quick-fix-label;
                                clicked => { root.apply-quick-fix(); }
                            }
                        }
                    }

                    // Live Monospaced Command Preview
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-code;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 10px;

                            Text {
                                horizontal-stretch: 1;
                                min-width: 0;
                                text: root.command-preview;
                                font-family: "Cascadia Mono";
                                font-size: 12.5px;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }

                            Button {
                                text: "复制命令";
                                clicked => { root.copy-command(); }
                            }
                        }
                    }

                    // Primary Action Bar
                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        Text {
                            text: root.is-busy ? "正在安全执行文件系统操作，请稍候..." : "检查通过后即可一键生效，过程自动写入执行日志";
                            font-size: 12.5px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }

                        Button {
                            text: root.is-busy
                                ? "正在执行..."
                                : (root.operation-mode == 1 ? "确认搬家并建链" : "立即创建链接");
                            primary: true;
                            enabled: root.can-execute && !root.is-busy;
                            height: 38px;
                            min-width: 156px;
                            clicked => { root.execute-action(); }
                        }
                    }
                }
            }

            // Card 4: Console Output (Shown when execution produced output)
            if root.console-output != "" : FluentCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "最近一次执行详情";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        if root.last-created-link != "" : HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "在资源管理器定位";
                                clicked => { root.reveal-created-link(); }
                            }
                            Button {
                                text: "转去体检此路径";
                                clicked => { root.inspect-created-link(); }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-code;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.console-output;
                                font-family: "Cascadia Mono";
                                font-size: 12.5px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
