import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Icons, VecIcon, FluentCard, StatusBadge, PillFilter, PageHeader, HistoryItemUi } from "theme.slint";

export component HistoryView inherits Rectangle {
    in-out property <string> filter-text;
    in-out property <int> category-filter: 0; // 0=All, 1=/D, 2=/J, 3=/H, 4=FILE, 5=Success, 6=Fail
    in property <int> total-count: 0;
    in property <[HistoryItemUi]> rows;

    callback filter-changed();
    callback request-clear-history();
    callback backfill-item(int);
    callback inspect-item(string);
    callback reveal-path(string);

    background: transparent;

    VerticalLayout {
        spacing: 18px;

        HorizontalLayout {
            alignment: space-between;
            spacing: 12px;

            PageHeader {
                horizontal-stretch: 1;
                title: "执行记录";
                subtitle: "已持久化的链接创建与迁移审计记录，支持一键回填参数或跳转体检。";
            }

            Button {
                text: "清空全部记录";
                enabled: root.total-count > 0;
                clicked => { root.request-clear-history(); }
            }
        }

        // Filter Card
        FluentCard {
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    LineEdit {
                        horizontal-stretch: 1;
                        min-width: 0;
                        height: 36px;
                        font-size: 13.5px;
                        placeholder-text: "按链接路径、目标路径、时间或结果关键词过滤...";
                        text <=> root.filter-text;
                        edited => { root.filter-changed(); }
                    }
                    Text {
                        text: "匹配 " + root.rows.length + " / " + root.total-count + " 条";
                        font-size: 12.5px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    for cat in [
                        { id: 0, label: "全部" },
                        { id: 1, label: "目录符号 (/D)" },
                        { id: 2, label: "目录联接 (/J)" },
                        { id: 3, label: "硬链接 (/H)" },
                        { id: 4, label: "文件符号" },
                        { id: 5, label: "仅成功" },
                        { id: 6, label: "仅失败" },
                    ]: PillFilter {
                        label: cat.label;
                        active: root.category-filter == cat.id;
                        clicked => {
                            root.category-filter = cat.id;
                            root.filter-changed();
                        }
                    }
                }
            }
        }

        // History Scrollable List
        if root.rows.length == 0 : FluentCard {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: root.total-count == 0 ? "暂无执行记录" : "没有符合当前筛选条件的记录";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.total-count == 0
                        ? "完成首次链接创建或迁移后，记录会自动保存在本地历史文件中。"
                        : "可以清空搜索关键词或切换到“全部”分类查看。";
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        if root.rows.length > 0 : hist-scroll := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: hist-scroll.visible-width;
                padding-right: 14px;
                padding-bottom: 18px;
                spacing: 10px;

                for item in root.rows : FluentCard {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                StatusBadge {
                                    label: item.success ? "成功" : "失败";
                                    tone: item.success ? 1 : 3;
                                }
                                StatusBadge {
                                    label: item.type-code;
                                    tone: 4;
                                }
                                Text {
                                    text: item.timestamp;
                                    font-size: 12.5px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "回填新建";
                                    clicked => { root.backfill-item(item.source-index); }
                                }
                                Button {
                                    text: "体检";
                                    clicked => { root.inspect-item(item.link-path); }
                                }
                                Button {
                                    text: "定位";
                                    clicked => { root.reveal-path(item.link-path); }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "链接： " + item.link-path;
                                font-family: "Cascadia Mono";
                                font-size: 12.5px;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "目标： " + item.target-path;
                                font-family: "Cascadia Mono";
                                font-size: 12.5px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            if item.result != "" : Text {
                                text: item.result;
                                font-size: 12.5px;
                                color: item.success ? Theme.success-fg : Theme.danger-fg;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
