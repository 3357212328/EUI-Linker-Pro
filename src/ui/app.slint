import { Button, Palette } from "std-widgets.slint";
import { Theme, Icons, VecIcon, FluentCard, StatusBadge, InspectItemUi, HistoryItemUi } from "theme.slint";
import { CreateView } from "create_page.slint";
import { InspectView } from "inspect_page.slint";
import { HistoryView } from "history_page.slint";
import { GuideView } from "guide_page.slint";

export { InspectItemUi, HistoryItemUi }

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-path;
    in property <int> badge-count: 0;
    in property <bool> active: false;
    callback clicked;

    height: 42px;
    border-radius: 8px;
    background: root.active ? Theme.accent-soft
              : area.has-hover ? Theme.bg-card : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent-border : transparent;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            VecIcon {
                icon-size: 18px;
                path-data: root.icon-path;
                icon-color: root.active ? Theme.accent : Theme.text-secondary;
            }
            Text {
                text: root.label;
                font-size: 13.5px;
                font-weight: root.active ? 700 : 500;
                vertical-alignment: center;
                color: root.active ? Theme.accent : Theme.text-primary;
            }
        }

        if root.badge-count > 0 : Rectangle {
            height: 20px;
            min-width: 24px;
            border-radius: 10px;
            background: root.active ? Theme.accent : Theme.bg-card;
            border-width: 1px;
            border-color: root.active ? Theme.accent : Theme.border;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                Text {
                    text: root.badge-count;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: root.active ? Theme.accent-on : Theme.text-secondary;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Fluent Linker Pro · NTFS 链接管家";
    icon: @image-url("../../assets/icon.png");
    default-font-family: "Microsoft YaHei UI";
    min-width: 980px;
    min-height: 680px;
    preferred-width: 1180px;
    preferred-height: 820px;
    background: Theme.bg-canvas;

    // Global App State
    in-out property <bool> dark-mode: true;
    in-out property <int> active-tab: 0; // 0=Create, 1=Inspect, 2=History, 3=Guide

    public function apply-theme(dark: bool) {
        Theme.is-dark = dark;
        root.dark-mode = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    init => {
        root.apply-theme(root.dark-mode);
    }
    in property <bool> is-admin: false;
    in property <bool> is-dev-mode: false;

    // Create Page State
    in-out property <int> create-operation-mode: 0;
    in-out property <int> create-link-type: 1;
    in-out property <string> create-link-path;
    in-out property <string> create-target-path;
    in-out property <bool> create-auto-create-parent: true;
    in property <bool> create-is-busy: false;
    in property <int> validation-level: 0;
    in property <string> validation-message: "填写链接位置与目标路径后，会自动完成合规检查。";
    in property <string> quick-fix-label;
    in property <bool> can-execute: false;
    in property <string> command-preview: "cmd /c mklink /J \"<链接路径>\" \"<目标路径>\"";
    in property <string> console-output;
    in property <string> last-created-link;

    // Inspect Page State
    in-out property <string> inspect-query-path;
    in-out property <bool> inspect-include-hard-links: true;
    in-out property <int> inspect-max-depth: 4;
    in property <bool> inspect-is-scanning: false;
    in property <string> inspect-status-text: "输入或选择路径后，可剖析单个链接属性或递归扫描文件夹内全部符号链接。";
    in property <bool> inspect-has-single: false;
    in property <string> inspect-single-path;
    in property <string> inspect-single-kind-code;
    in property <string> inspect-single-kind-label;
    in property <string> inspect-single-target;
    in property <string> inspect-single-detail;
    in property <bool> inspect-single-healthy: false;
    in property <bool> inspect-single-can-unlink: false;
    in property <[string]> inspect-single-siblings;
    in property <[InspectItemUi]> inspect-scan-rows;

    // History Page State
    in-out property <string> history-filter-text;
    in-out property <int> history-category-filter: 0;
    in property <int> history-total-count: 0;
    in property <[HistoryItemUi]> history-rows;

    // Confirmation Dialog State
    in-out property <bool> confirm-open: false;
    in property <string> confirm-title;
    in property <string> confirm-message;
    in property <string> confirm-primary-label: "确认执行";

    // Toast State
    in-out property <bool> toast-visible: false;
    in property <string> toast-title;
    in property <string> toast-message;
    in property <int> toast-tone: 1; // 0=info, 1=success, 2=warning, 3=error

    // App Callbacks
    callback toggle-theme();
    callback tab-changed(int);

    // Create Callbacks
    callback create-mode-changed(int);
    callback create-link-type-changed(int);
    callback create-parameters-edited();
    callback create-swap-paths();
    callback create-browse-link-save();
    callback create-browse-link-folder();
    callback create-browse-link-file();
    callback create-browse-target-folder();
    callback create-browse-target-file();
    callback create-apply-quick-fix();
    callback create-execute();
    callback create-copy-command();
    callback create-fill-example();
    callback create-clear-inputs();
    callback create-reveal-created();
    callback create-inspect-created();

    // Inspect Callbacks
    callback inspect-browse-folder();
    callback inspect-browse-file();
    callback inspect-single();
    callback inspect-start-scan();
    callback inspect-cancel-scan();
    callback inspect-specific(string);
    callback inspect-request-unlink(string);

    // History Callbacks
    callback history-filter-changed();
    callback history-request-clear();
    callback history-backfill(int);
    callback history-inspect-item(string);

    // Guide / System Callbacks
    callback relaunch-admin();
    callback open-dev-settings();
    callback refresh-privileges();

    // Shared / Dialog Callbacks
    callback reveal-path(string);
    callback copy-text(string);
    callback confirm-accepted();
    callback confirm-canceled();
    callback dismiss-toast();

    FocusScope {
        key-pressed(event) => {
            if (root.confirm-open && event.text == Key.Escape) {
                root.confirm-canceled();
                return accept;
            }
            if (event.modifiers.control) {
                if (event.text == "1") { root.active-tab = 0; root.tab-changed(0); return accept; }
                if (event.text == "2") { root.active-tab = 1; root.tab-changed(1); return accept; }
                if (event.text == "3") { root.active-tab = 2; root.tab-changed(2); return accept; }
                if (event.text == "4") { root.active-tab = 3; root.tab-changed(3); return accept; }
            }
            return reject;
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;

            // Left Fluent Sidebar Navigation Rail
            Rectangle {
                width: 236px;
                background: Theme.bg-sidebar;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    alignment: space-between;

                    // Top Brand + Navigation Items
                    VerticalLayout {
                        spacing: 18px;

                        // Brand Lockup
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-top: 4px;
                            spacing: 11px;

                            Image {
                                width: 34px;
                                height: 34px;
                                source: @image-url("../../assets/icon.png");
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: "Fluent Linker";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: "NTFS 符号链接管家";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                }
                            }
                        }

                        // Workspace Group
                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "工作区";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-muted;
                            }

                            NavItem {
                                label: "新建与迁移";
                                icon-path: Icons.add-link;
                                active: root.active-tab == 0;
                                clicked => { root.active-tab = 0; root.tab-changed(0); }
                            }
                            NavItem {
                                label: "体检与扫描";
                                icon-path: Icons.search;
                                badge-count: root.inspect-scan-rows.length;
                                active: root.active-tab == 1;
                                clicked => { root.active-tab = 1; root.tab-changed(1); }
                            }
                            NavItem {
                                label: "执行记录";
                                icon-path: Icons.history;
                                badge-count: root.history-total-count;
                                active: root.active-tab == 2;
                                clicked => { root.active-tab = 2; root.tab-changed(2); }
                            }
                            NavItem {
                                label: "环境与指南";
                                icon-path: Icons.shield;
                                active: root.active-tab == 3;
                                clicked => { root.active-tab = 3; root.tab-changed(3); }
                            }
                        }
                    }

                    // Bottom Environment Status & Theme Switch
                    VerticalLayout {
                        spacing: 10px;

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        // Compact Privilege Pill
                        Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            border-width: 1px;
                            background: root.is-admin ? Theme.success-bg
                                      : root.is-dev-mode ? Theme.info-bg : Theme.warning-bg;
                            border-color: root.is-admin ? Theme.success-bd
                                        : root.is-dev-mode ? Theme.info-bd : Theme.warning-bd;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (!root.is-admin) {
                                        root.relaunch-admin();
                                    } else {
                                        root.active-tab = 3;
                                        root.tab-changed(3);
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                spacing: 8px;
                                VecIcon {
                                    icon-size: 16px;
                                    path-data: Icons.shield;
                                    icon-color: root.is-admin ? Theme.success-fg
                                              : root.is-dev-mode ? Theme.info-fg : Theme.warning-fg;
                                }
                                Text {
                                    text: root.is-admin ? "管理员权限运行中"
                                        : root.is-dev-mode ? "开发者免提权可用" : "点击提权至管理员";
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    color: root.is-admin ? Theme.success-fg
                                         : root.is-dev-mode ? Theme.info-fg : Theme.warning-fg;
                                }
                            }
                        }

                        // Dark / Light Theme Button
                        Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: theme-area.has-hover ? Theme.bg-card-hover : Theme.bg-card;
                            animate background { duration: 140ms; }

                            theme-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-theme(); }
                            }

                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                spacing: 8px;
                                VecIcon {
                                    icon-size: 16px;
                                    path-data: root.dark-mode ? Icons.sun : Icons.moon;
                                    icon-color: Theme.text-secondary;
                                }
                                Text {
                                    text: root.dark-mode ? "切换浅色外观" : "切换深色外观";
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    color: Theme.text-primary;
                                }
                            }
                        }
                    }
                }
            }

            // Hairline Sidebar Divider
            Rectangle {
                width: 1px;
                background: Theme.border;
            }

            // Right Spacious Workspace Host
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0;
                background: Theme.bg-canvas;

                HorizontalLayout {
                    padding: 28px;

                    if root.active-tab == 0 : CreateView {
                        operation-mode <=> root.create-operation-mode;
                        link-type <=> root.create-link-type;
                        link-path <=> root.create-link-path;
                        target-path <=> root.create-target-path;
                        auto-create-parent <=> root.create-auto-create-parent;
                        is-busy: root.create-is-busy;
                        validation-level: root.validation-level;
                        validation-message: root.validation-message;
                        quick-fix-label: root.quick-fix-label;
                        can-execute: root.can-execute;
                        command-preview: root.command-preview;
                        console-output: root.console-output;
                        last-created-link: root.last-created-link;

                        mode-changed(m) => { root.create-mode-changed(m); }
                        link-type-changed(t) => { root.create-link-type-changed(t); }
                        parameters-edited => { root.create-parameters-edited(); }
                        swap-paths => { root.create-swap-paths(); }
                        browse-link-save => { root.create-browse-link-save(); }
                        browse-link-folder => { root.create-browse-link-folder(); }
                        browse-link-file => { root.create-browse-link-file(); }
                        browse-target-folder => { root.create-browse-target-folder(); }
                        browse-target-file => { root.create-browse-target-file(); }
                        apply-quick-fix => { root.create-apply-quick-fix(); }
                        execute-action => { root.create-execute(); }
                        copy-command => { root.create-copy-command(); }
                        fill-example => { root.create-fill-example(); }
                        clear-inputs => { root.create-clear-inputs(); }
                        reveal-created-link => { root.create-reveal-created(); }
                        inspect-created-link => { root.create-inspect-created(); }
                    }

                    if root.active-tab == 1 : InspectView {
                        query-path <=> root.inspect-query-path;
                        include-hard-links <=> root.inspect-include-hard-links;
                        max-depth <=> root.inspect-max-depth;
                        is-scanning: root.inspect-is-scanning;
                        status-text: root.inspect-status-text;
                        has-single-result: root.inspect-has-single;
                        single-path: root.inspect-single-path;
                        single-kind-code: root.inspect-single-kind-code;
                        single-kind-label: root.inspect-single-kind-label;
                        single-target: root.inspect-single-target;
                        single-detail: root.inspect-single-detail;
                        single-healthy: root.inspect-single-healthy;
                        single-can-unlink: root.inspect-single-can-unlink;
                        single-siblings: root.inspect-single-siblings;
                        scan-rows: root.inspect-scan-rows;

                        browse-folder => { root.inspect-browse-folder(); }
                        browse-file => { root.inspect-browse-file(); }
                        inspect-single => { root.inspect-single(); }
                        start-scan => { root.inspect-start-scan(); }
                        cancel-scan => { root.inspect-cancel-scan(); }
                        reveal-path(p) => { root.reveal-path(p); }
                        copy-text(t) => { root.copy-text(t); }
                        inspect-specific(p) => { root.inspect-specific(p); }
                        request-unlink(p) => { root.inspect-request-unlink(p); }
                    }

                    if root.active-tab == 2 : HistoryView {
                        filter-text <=> root.history-filter-text;
                        category-filter <=> root.history-category-filter;
                        total-count: root.history-total-count;
                        rows: root.history-rows;

                        filter-changed => { root.history-filter-changed(); }
                        request-clear-history => { root.history-request-clear(); }
                        backfill-item(idx) => { root.history-backfill(idx); }
                        inspect-item(p) => { root.history-inspect-item(p); }
                        reveal-path(p) => { root.reveal-path(p); }
                    }

                    if root.active-tab == 3 : GuideView {
                        is-admin: root.is-admin;
                        is-dev-mode: root.is-dev-mode;

                        relaunch-admin => { root.relaunch-admin(); }
                        open-dev-settings => { root.open-dev-settings(); }
                        refresh-privileges => { root.refresh-privileges(); }
                    }
                }
            }
        }
    }

    // Global Modal Confirmation Overlay
    if root.confirm-open : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg-backdrop;

        // Swallow backdrop clicks cleanly
        TouchArea {}

        FluentCard {
            width: 520px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 22px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;
                    VecIcon {
                        icon-size: 20px;
                        path-data: Icons.warn;
                        icon-color: Theme.warning-fg;
                    }
                    Text {
                        text: root.confirm-title;
                        font-size: 16.5px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.confirm-message;
                    font-size: 13.5px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    padding-top: 6px;
                    alignment: end;
                    spacing: 10px;

                    Button {
                        text: "取消";
                        clicked => { root.confirm-canceled(); }
                    }
                    Button {
                        text: root.confirm-primary-label;
                        primary: true;
                        clicked => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }

    // Global Floating Toast Notification (Bottom-Right)
    if root.toast-visible : FluentCard {
        width: 390px;
        x: parent.width - self.width - 28px;
        y: parent.height - self.height - 24px;
        border-color: root.toast-tone == 1 ? Theme.success-bd
                    : root.toast-tone == 2 ? Theme.warning-bd
                    : root.toast-tone == 3 ? Theme.danger-bd
                    : Theme.info-bd;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.dismiss-toast(); }
        }

        HorizontalLayout {
            padding: 14px;
            spacing: 12px;

            VecIcon {
                icon-size: 20px;
                path-data: root.toast-tone == 1 ? Icons.check : Icons.warn;
                icon-color: root.toast-tone == 1 ? Theme.success-fg
                          : root.toast-tone == 2 ? Theme.warning-fg
                          : root.toast-tone == 3 ? Theme.danger-fg
                          : Theme.info-fg;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0;
                spacing: 3px;

                Text {
                    text: root.toast-title;
                    font-size: 13.5px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.toast-message;
                    font-size: 12.5px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
    }
}
